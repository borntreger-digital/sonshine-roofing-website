{
  "ref": "sonshine_website_https",
  "description": "Upgrade SonShine website HTTP visits to canonical HTTPS",
  "expression": "(http.host in {\"sonshineroofing.com\" \"www.sonshineroofing.com\"} and not ssl)",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://sonshineroofing.com\", http.request.uri.path)"
      },
      "status_code": 308,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
